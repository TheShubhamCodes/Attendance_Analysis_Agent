# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# Database Connection (Neon PostgreSQL with connection pooling)
# Pooled connection string (used for normal app queries):
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-host>.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string (used for Prisma migrations):
DIRECT_URL="postgresql://<user>:<password>@<ep-direct-host>.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret & Expiration
JWT_SECRET="replace_with_a_strong_random_jwt_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (Comma-separated for multiple origins, e.g. Vercel domain + localhost)
CORS_ORIGIN="https://your-attendance-app.vercel.app,http://localhost:5173"
